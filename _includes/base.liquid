<!doctype html>
<html>
<head>
    <title>{% if page.title %}{{ page.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:ital,wght@0,200..800;1,200..800&family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ '/style.css'  }}">
    <link rel="icon" type="image/x-png" href="{{ '/Clight.png'  }}">
</head>
<body>
<header>
<nav style="display:flex; align-items:top">
{% assign h = 50 %}
{% assign w = 100 %}
<a style="line-height:0;" href="{{ site.baseurl | default: '/' }}">
<svg id="eyes" height="{{ h }}" width="{{ w }}" viewBox="-50 0 100 50" xmlns="http://www.w3.org/2000/svg">
    <defs>
    <path id="eye-path" d="M-15 -2Q-2,15 15,2Q2,-15 -15,-2Z"/>
    <path id="pupil-path" d="M0 -7Q-7 0, 0 7Q7 0,0 -7Z"/>
    <clipPath id="eye-clip">
        <use href="#eye-path"/>
    </clipPath>
    </defs> 
    <path d="M-100 30.5H100" stroke-width="1" rendering="crispEdges" class="svg-fg-stroke"/>
    {% for i in (0..1) %}
        <g transform="translate({{ i | F | times: 20}} 15) scale({{ i | F | times : -1 }} 1)" >
            <g clip-path="url(#eye-clip)">
                <use id="pupil-{{ i }}" href="#pupil-path" class="svg-fg-stroke" fill="#222" stroke-width="1" />
            </g>
            <g id="eye-{{ i }}">
                <use href="#eye-path" stroke-width="1" class="svg-fg-stroke" fill="none"/>
            </g>
        </g>

        {% for j in (0..2) %}
            {% assign offset = j | times: 6 %}
            <path d="M{{ i | times: 80 | minus: 50 | plus: offset }} 25q3,20 6,0" class="svg-fg-stroke svg-bg-fill" stroke-width="1"/>
        {% endfor %}
    {% endfor %}
    <path d="M0 27m-7 -3 l6 20 q2,2 4,0 l6 -20" class="svg-fg-stroke svg-bg-fill" stroke-width="1"/>
</svg></a>

{% for link in nav %}
    <a style="height:30px;padding:0 0.2rem;align-content:end;border-bottom:1px solid var(--fg);" 
       href="{{ link.url  }}" 
       >
        {{ link.name }}
    </a>
{% endfor %}
<span style="flex:1;height:30px;border-bottom:1px solid;"></span> 
</nav>
</header>

<main>
    {{ content }}
</main>

<footer style="border-top:1px solid var(--fg)">
</footer>

<script src="{{ '/eyes.js' }}"></script>
</body>
</html>
